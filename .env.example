# Store Intelligence — Environment Variables
# Copy to .env and adjust as needed

# Database (SQLite by default — change to postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:////app/data/store_intelligence.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# API version
APP_VERSION=1.0.0

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend URL (used by frontend docker container)
BACKEND_URL=https://visionretail-iq.onrender.com

# Groq API Configuration (optional - enables AI-powered insights)
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
